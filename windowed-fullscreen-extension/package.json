{
  "name": "windowed-fullscreen-extension",
  "//version": "Mirrors manifest.json, which is authoritative. scripts/build.mjs fails if they drift.",
  "version": "2.0.0",
  "description": "Chromium MV3 extension that adds a windowed-fullscreen viewing mode to YouTube.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "verify:live": "node scripts/verify-live.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "store:assets": "node store-assets/marketing/render.mjs && node store-assets/marketing/verify.mjs",
    "store:icons": "node store-assets/marketing/icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.2",
    "esbuild": "0.24.2",
    "typescript": "5.7.2"
  }
}
