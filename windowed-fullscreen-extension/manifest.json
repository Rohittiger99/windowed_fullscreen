{
  "manifest_version": 3,
  "name": "Windowed Fullscreen for YouTube™",
  "version": "2.0.0",
  "description": "Watch YouTube full-window without true fullscreen: tabs, taskbar and clock stay visible. Dock the comments beside the video.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://rohittiger.vercel.app/product/windowedfullscreen",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "popup/index.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Windowed Fullscreen",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-windowed-fullscreen": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle windowed fullscreen mode"
    },
    "toggle-comment-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Dock the comments beside the video"
    },
    "capture-frame": {
      "description": "Save the current frame as an image (Pro)"
    }
  }
}
