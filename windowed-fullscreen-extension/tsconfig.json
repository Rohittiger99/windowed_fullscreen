{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Tests import "../src/windowed-fullscreen.ts" with the extension spelled
    // out, because Node's type stripping does no extension resolution. Safe here
    // only because nothing is ever emitted from this config.
    "allowImportingTsExtensions": true
  },
  // `tests` is included so a type error in a test fails `npm run typecheck`
  // rather than surfacing only when the suite runs.
  "include": ["src", "scripts", "tests"],
  "exclude": ["node_modules", "extension", "store-assets"]
}
